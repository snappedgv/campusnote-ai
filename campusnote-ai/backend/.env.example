# ==========================================================
# CampusNote AI - Backend Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to source control.
# ==========================================================

# --- Database ---
# SQLite for development. Swap for postgresql://user:pass@host/db later.
DATABASE_URL=https://campusnote-ai-backend.onrender.com

# --- LLM (Anthropic Claude) ---
# Used to generate grounded exam answers from retrieved chunks.
LLM_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1500

# --- Embeddings ---
# "local" uses a free on-device sentence-transformers model (default, no API key needed).
# "anthropic" is a placeholder for future first-party embeddings.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- JWT Auth ---
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Vector store ---
CHROMA_PATH=../data/chroma

# --- File storage ---
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE=20971520

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Optional LMS integration (Section 21, not enabled by default) ---
LMS_API_BASE_URL=
LMS_API_TOKEN=
